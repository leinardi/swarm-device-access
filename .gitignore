# OS files
.DS_Store
Thumbs.db
desktop.ini

# IntelliJ: only the shared code style and copyright profile are tracked
.idea/*
!.idea/codeStyles/
!.idea/copyright/
*.iml

# Other editors
.vscode/
*.code-workspace
*.swp
*~

# --- Go build outputs ---
/dist/
/bin/
/build/
/coverage.out
/coverage.html
*.test
*.out
*.prof
*.pprof
*.coverprofile
profile.*

# Go workspaces (if you ever use them)
go.work
go.work.sum

# Vendoring (if you ever run go mod vendor)
vendor/

# Tool caches
.cache/

# Claude Code: the shared settings and the skills symlink are tracked; local settings
# (settings.local.json) and session state never are.
.claude/*
!.claude/settings.json
!.claude/skills

# --- Rust build outputs ---
/target/
